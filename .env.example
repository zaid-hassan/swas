# SWAS environment variables
# Copy to `.env.local` and fill in real values: `cp .env.example .env.local`
# Never commit `.env.local` — it is gitignored.
#
# Variables prefixed NEXT_PUBLIC_ are embedded in the client bundle and are
# therefore public. Never put secrets in them.

# ---------------------------------------------------------------------------
# Firebase — web client (lib/firebase.ts)
# From Firebase console → Project settings → General → Your apps (Web app)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase — Admin SDK (lib/firebase-admin.ts, scripts/seed-products.ts)
# From Firebase console → Project settings → Service accounts
# → "Generate new private key". Server-side only.
#
# FIREBASE_PRIVATE_KEY must be the full key on ONE line with literal \n
# escapes between lines (the code converts \n back to newlines at runtime).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Access control (lib/admin-auth.ts)
# Comma-separated lists of emails. A super admin can also manage admins.
# NEXT_PUBLIC_ADMIN_EMAIL is the legacy single-admin variable; it still works
# and counts as a (super) admin, but prefer the list variables below.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_EMAILS=
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Razorpay (lib/razorpay.ts, app/api/payments/verify/route.ts)
# From https://dashboard.razorpay.com → Settings → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Resend — transactional order emails (lib/email/send-order-email.ts)
# FROM_EMAIL must be a verified sender/domain on your Resend account.
# OWNER_EMAIL receives the "new order" notification.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=orders@yourdomain.com
OWNER_EMAIL=you@yourdomain.com

# ---------------------------------------------------------------------------
# Cloudinary — unsigned product media uploads (lib/media-upload.ts)
# From Cloudinary console → Settings → Upload → Upload presets.
# Create an UNSIGNED preset (resource_type: auto, folder: swas/products).
# ---------------------------------------------------------------------------
# Default cloud name matches the Cloudinary assets already used by SWAS.
# Override only if this project is moved to a different Cloudinary account.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dndppvnjl
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=swas_products

# ---------------------------------------------------------------------------
# Local development only — Firestore emulator
# Used by `pnpm test:emulator` (scripts/emulator-test.ts) and the emulator
# test suites. Defaults to localhost:8080 when unset; leave blank in
# production (Vercel).
# ---------------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST=
